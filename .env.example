# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата/аккаунта, куда присылать заявки (свой user id или id группы)
TELEGRAM_CHAT_ID=

# Пароль для входа в /admin (публикация отзывов). Придумай свой, длинный.
ADMIN_PASSWORD=

# Redis для хранения отзывов — подключи в Vercel: Storage → Marketplace →
# Redis (Upstash). Переменные подставятся автоматически под одним из этих
# имён (KV_REST_API_URL/TOKEN или UPSTASH_REDIS_REST_URL/TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Отдельный бот для карточек вещей из /admin (создать через @BotFather и нажать /start).
# Чат по умолчанию — TELEGRAM_CHAT_ID; ITEM_CHAT_ID нужен, только если карточки должны идти в другой чат.
ITEM_BOT_TOKEN=
ITEM_CHAT_ID=
